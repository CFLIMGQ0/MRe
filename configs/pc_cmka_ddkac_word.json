{
  "method": "PC-CMKA-DDKAC",
  "design_source": "PC-CMKA-DDKAC_最终创新方案.docx",
  "prior": {
    "source": "train_fold_correlation_fallback",
    "edge_list": null,
    "neighbours": 8,
    "minimum_weight": 0.001
  },
  "spectral": {
    "moment_order": 2,
    "spectral_bound": null,
    "normalization": "reference",
    "epsilon": 1e-06
  },
  "dictionary": {
    "rank": 4
  },
  "target": {
    "hidden_dim": 32,
    "max_offset": 0.25,
    "min_precision": 0.1
  },
  "solver": {
    "mode": "differentiable",
    "iterations": 3,
    "step_size": 0.05,
    "beta": 0.1,
    "lambda_rho": 0.01,
    "rho_max": 0.5,
    "fixed_rho": 0.25,
    "gradient_clip": 5.0
  },
  "calibration_mode": "inverse",
  "trust_mode": "minimum",
  "probe_mode": "functional",
  "augmentation": {
    "mode": "hessian_antithetic",
    "hessian_mode": "diagonal",
    "hessian_low_rank": 2,
    "damping": 0.01,
    "xi_max": 0.2,
    "krylov_enabled": true,
    "krylov_eta": 0.1,
    "shared_route": true,
    "train_only": true,
    "bernoulli_keep": 0.8,
    "minimum_probability": 0.25,
    "controller_beta": 0.2,
    "controller_ema": 0.9
  },
  "ssl": {
    "mode": "structure_fusion_gate"
  },
  "identifiability": {
    "mode": "randomized",
    "random_probes": 1,
    "tau": 0.001
  },
  "loss": {
    "lambda_moment": 0.01,
    "lambda_trust": 0.001,
    "lambda_ssl": 0.01,
    "lambda_id": 0.001,
    "lambda_dictionary": 0.0001,
    "lambda_structure": 1.0,
    "lambda_fusion": 0.5,
    "lambda_gate": 0.1
  },
  "bernoulli_kan": {
    "mode": "off",
    "dropout": 0.25,
    "grid_size": 5,
    "coarse_grid": 3,
    "fine_grid": 7,
    "adapter_rank": 4,
    "tau": 1.0,
    "ema": 0.95,
    "gate_temperature": 0.1,
    "jensen_epsilon": 0.05,
    "controller_gradient_scale": 1.0,
    "lambda_view": 0.01,
    "lambda_jacobian": 0.001,
    "lambda_anchor": 0.01,
    "lambda_adapter": 0.0001,
    "lambda_lattice": 0.01
  },
  "experiments": [
