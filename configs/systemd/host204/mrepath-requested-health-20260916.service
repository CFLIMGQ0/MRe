[Unit]
Description=Health watchdog for requested six-GPU experiments
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/xmlg/Lim/Project1
ExecStart=/xmlg/Lim/Project1/.venvs/repository_baselines_20260913/bin/python -u /xmlg/Lim/Project1/scripts/monitor_requested_experiments.py --state-dir /xmlg/Lim/Project1/results/requested_full_20260916/scheduler --poll-seconds 60 --critical-free-gib 20
Environment=PYTHONDONTWRITEBYTECODE=1
Restart=always
RestartSec=60

[Install]
WantedBy=default.target
